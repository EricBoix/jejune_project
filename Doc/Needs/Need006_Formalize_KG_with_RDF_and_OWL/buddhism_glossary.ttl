bud:Somobodhi a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "somobodhi"@sa ;
    skos:definition "A potential Buddha-nature or seed of enlightenment existing within all sentient beings universally."@en .

bud:Sopaka a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "sopaka"@pi ;
