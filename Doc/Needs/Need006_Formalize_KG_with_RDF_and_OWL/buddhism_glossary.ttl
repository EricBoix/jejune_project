    skos:definition "Ethical conduct or morality; constitutes one of the three trainings fundamental to Buddhist practice."@en .

bud:Skandha a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "skandha"@sa ;
