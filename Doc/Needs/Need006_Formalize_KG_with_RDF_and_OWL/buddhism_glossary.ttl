#######################################################################
# An informal trial at producing some form glossary...
#
# Claude request:  
#   Get the content of the table of the glossary ata
#   https://en.wikipedia.org/wiki/Glossary_of_Buddhism and extract
#   each term as an ontological entity (knowledge graph terminology).
#   Store the resulting information in a rdf/owl file.
# This file is the response, with the following caveats:
#   The ontology is written and structurally consistent.
#   Contents:
#     - 242 owl:Class declarations — 1 top-level bud:BuddhistConcept
#       + 241 glossary terms, all as subclasses.
#     - Each term carries rdfs:label with original transliteration
#       + language tag (@sa Sanskrit, @pi Pāli ... @en English).
#     - Each has a skos:definition sourced from the Wikipedia entry.
#     - 11 skos:altLabels model dual-form entries (e.g. bhikkhu/bhikshu,
#       dharma/dhamma, Nirvana/Nibbana).
#     - anicca vs anitya linked by owl:equivalentClass.
#     - Ontology metadata block: dct:title, dct:description, dct:source
#       (Wikipedia URL), dct:created, owl:versionInfo.
#   Caveats:
#     - Definitions were paraphrased by WebFetch's internal summarizer,
#       not verbatim from Wikipedia. If literal quotations are needed,
#       the re-fetch with raw HTML (e.g. curl + manual parse)
#     - Could not install rdflib to validate; only did lexical sanity
#       checks. If you have rapper or a venv with rdflib, worth running
#       once.
#########################################################################

@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix bud:   <http://example.org/ontology/buddhism#> .

#################################################################
# Ontology metadata
#################################################################

<http://example.org/ontology/buddhism> a owl:Ontology ;
    dct:title       "Buddhism Glossary Ontology"@en ;
    dct:description "An OWL ontology extracted from the Wikipedia 'Glossary of Buddhism' article. Each glossary entry is modeled as an owl:Class subsumed under bud:BuddhistConcept, with the original transliterated term as rdfs:label and the Wikipedia definition as skos:definition."@en ;
    dct:source      <https://en.wikipedia.org/wiki/Glossary_of_Buddhism> ;
    dct:created     "2026-10-19"^^xsd:date ;
    owl:versionInfo "1.0" .

#################################################################
# Top-level class
#################################################################

bud:BuddhistConcept a owl:Class ;
    rdfs:label   "Buddhist Concept"@en ;
    rdfs:comment "Top-level class subsuming every term listed in the Wikipedia Glossary of Buddhism."@en .

#################################################################
# Letter A
#################################################################

bud:Abhidharma a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "abhidharma"@sa ;
    skos:definition "Scholarly teachings of the Buddha. A category of scriptures that attempts to use Buddhist teachings to create a systematic, abstract description of all worldly phenomena."@en .

bud:Avatamsakasutra a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Avataṃsakasūtra"@sa ;
    skos:definition "Garland Scripture — a Mahāyāna sūtra which discusses the Bodhisattva path and a variety of teachings."@en .

bud:AbhidhammaPitaka a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Abhidhamma Pitaka"@pi ;
    skos:definition "The third basket of the Tripitaka canon, reorganizing all doctrines systematically."@en .

bud:Abhiniskramanasutra a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Abhiniṣkramaṇasūtra"@sa ;
    skos:definition "Sūtra of the Great Renunciation — a translation of the Chinese text Fo Benxing Ji Jing, a biography of the Buddha."@en .

bud:Acharya a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Acharya"@sa ;
    skos:definition "A teacher who demonstrates deep understanding of Dhamma and guides novice Bhikkus responsibly."@en .

bud:Adbhutadharmaparyayasutra a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Adbhutadharmaparyāyasūtra"@sa ;
    skos:definition "Part of the Gilgit Manuscripts concerning merit-making through building stūpas, images, and relics."@en .

bud:Adhigamadharma a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Adhigamadharma"@sa ;
    skos:definition "The Dharma of Realization — practical Buddhist application through higher discipline, mindfulness, and wisdom."@en .

bud:Adhitthana a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "adhitthana"@pi ;
    skos:definition "Determination, resolution, or will; one of the Ten Perfections."@en .

bud:Agama a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Āgama"@sa ;
    skos:definition "A category of early Buddhist texts preserved in Chinese; Theravāda uses the term nikāya instead."@en .

bud:Agamadharma a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Āgamadharma"@sa ;
    skos:definition "The Dharma of Transmission — a word for the Tripitaka, contrasted with practical scripture application."@en .

bud:Ahimsa a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "ahimsa"@sa ;
    skos:definition "The devotion to non-violence and respect for all forms of life. Practitioners of ahimsa are often vegetarians or vegans."@en .

bud:Akshobhya a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Akshobhya"@sa ;
    skos:definition "One of the Five Tathāgatas or Five Wisdom Buddhas, alongside Ratnasambhava, Amitābha, Vairocana, and Amoghasiddhi."@en .

bud:Akusalakarmapatha a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "akuśalakarmapatha"@sa ;
    skos:definition "In Tibetan Buddhism, a list of ten unwholesome courses of action including killing, stealing, and wrong view."@en .

bud:Alayavijnana a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "alayavijnana"@sa ;
    skos:definition "Store consciousness — representing the deepest level of mind that stores all karmic seeds (experiences, actions, and memories)."@en .

bud:Amitabha a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Amitabha"@sa ;
    skos:definition "The Buddha of Infinite Light — main buddha of the Pure Land school, popular in other Mahāyāna sects."@en .

bud:Amitabhasutra a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Amitābhasūtra"@sa ;
    skos:definition "A sūtra focused on Amitabha Buddha's teachings and realm."@en .

bud:Amoghasiddhi a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Amoghasiddhi"@sa ;
    skos:definition "One of the Five Wisdom Buddhas in Mahāyāna Buddhism."@en .

bud:Anagarika a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "anagārika"@pi ;
    skos:definition "A white-clothed student in the Theravāda tradition who awaits being considered for sāmaṇera ordination."@en .

bud:Anapanasati a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "anapanasati"@pi ;
    skos:definition "Mindfulness of the breath meditation."@en .

bud:Anatta a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "anatta"@pi ;
    skos:definition "The principle denial of the soul in any phenomena, teaching that no permanent self exists."@en .

bud:Anicca a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "anicca"@pi ;
    skos:definition "Impermanence — one of the three marks of existence in Buddhism."@en .

bud:Anitya a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "anitya"@sa ;
    skos:definition "Impermanence, synonymous with anicca."@en ;
    owl:equivalentClass bud:Anicca .

bud:Anuttara a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "anuttara"@sa ;
    skos:definition "Unsurpassing — referring to the highest level of Buddhist attainment."@en .

bud:AnuttaraSamyakSambodhi a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "anuttara samyak sambodhi"@sa ;
    skos:definition "Unsurpassable, complete, perfect enlightenment; unsurpassable, right, and full enlightenment."@en .

bud:Arhat a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "arhat"@sa ;
    skos:definition "The Worthy One — a living person who has reached Enlightenment in Buddhist tradition."@en .

bud:Arupyaraga a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "ārūpyarāga"@sa ;
    skos:definition "Attachment to formless realms in Buddhist cosmology."@en .

bud:Asura a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "asura"@sa ;
    skos:definition "Nongods — supernatural beings in Buddhist cosmology, often depicted as contentious."@en .

bud:Atman a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "atman"@sa ;
    skos:definition "Literally 'self'. In Buddhism, the predominant teaching is the negating doctrine of anatman."@en .

bud:Avalokitesvara a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Avalokitesvara"@sa ;
    skos:definition "One Who Hears the Suffering Cries of the World — the bodhisattva of compassion."@en .

bud:Avidya a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "avidya"@sa ;
    skos:definition "Ignorance or delusion — fundamental ignorance leading to suffering in Buddhist philosophy."@en .

#################################################################
# Letter B
#################################################################

bud:Bardo a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "bardo"@bo ;
    skos:definition "Intermediate state or in-between state — according to Tibetan tradition, existence between lives."@en .

bud:Bhavacakra a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "bhavacakra"@sa ;
    skos:altLabel "bhavacakka"@pi ;
    skos:definition "A circular symbolic representation of saṃsāra, also known as the Wheel of Becoming."@en .

bud:Bhante a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "bhante"@pi ;
    skos:definition "The polite particle used to refer to Buddhist monks in Theravāda tradition, meaning 'Venerable Sir'."@en .

bud:Bhava a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "bhava"@sa ;
    skos:definition "Becoming, being, existing; the 10th link of Pratītya-samutpāda."@en .

bud:Bhikkhu a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "bhikkhu"@pi ;
    skos:altLabel "bhikshu"@sa ;
    skos:definition "Beggar — a Buddhist monk who has taken full ordination vows."@en .

bud:Bhikkhuni a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "bhikkhuni"@pi ;
    skos:altLabel "bhikshuni"@sa ;
    skos:definition "A Buddhist nun who has taken full ordination vows."@en .

bud:Bija a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "bija"@sa ;
    skos:definition "Seed — a metaphor for origin or cause used in Yogācāra school teachings."@en .

bud:Bodhi a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "bodhi"@sa ;
    skos:definition "Awakening or Enlightenment in Buddhist tradition."@en .

bud:Bodhisattvapitaka a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Bodhisattvapiṭaka"@sa ;
    skos:definition "The Bodhisattva Basket — a collection of Buddhist scriptures."@en .

bud:BodhiTree a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Bodhi tree"@en ;
    skos:definition "The Sacred Fig (Ficus religiosa) tree under which Gautama reached Enlightenment."@en .

bud:Bodhicaryavatara a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Bodhicaryāvatāra"@sa ;
    skos:definition "Introduction to the Practice of Enlightenment, written by Śāntideva."@en .

bud:Bodhicitta a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "bodhicitta"@sa ;
    skos:definition "The motivation of a bodhisattva to achieve enlightenment for all beings."@en .

bud:Bodhisattva a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "bodhisattva"@sa ;
    skos:definition "One with the intention to become a Buddha in order to liberate all other sentient beings from suffering."@en .

bud:Boghda a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Boghda"@mn ;
    skos:definition "Holy, living Buddha or living Bodhisattva — title of highest Buddhist masters."@en .

bud:Buddha a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Buddha"@sa ;
    skos:definition "A Buddha; also, the Buddha Siddhārtha Gautama — one who has awakened."@en .

bud:BuddhaNature a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "buddha nature"@en ;
    skos:definition "The uncreated and deathless Buddhic element or principle concealed within all sentient beings to achieve Awakening."@en .

bud:Buddhism a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Buddhism"@en ;
    skos:definition "The religion and philosophical tradition based on teachings attributed to the Gautama Buddha."@en .

#################################################################
# Letter C
#################################################################

bud:Cetana a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "cetana"@pi ;
    skos:definition "Volition — the mental factor of intention in Buddhist psychology."@en .

bud:Cetiya a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Cetiya"@pi ;
    skos:definition "A reliquary holding holy objects of veneration in Buddhist practice."@en .

bud:Chanda a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "chanda"@pi ;
    skos:definition "Intention, interest, desire to act, aspiration in Buddhist contexts."@en .

#################################################################
# Letter D
#################################################################

bud:Dakini a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dakini"@sa ;
    skos:definition "A supernatural female with volatile temperament who serves as a muse for spiritual practice."@en .

bud:DalaiLama a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Dalai Lama"@en ;
    skos:definition "The lama with wisdom like an ocean — secular and spiritual leader of Tibet."@en .

bud:Dana a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dana"@sa ;
    skos:definition "Generosity or giving; in Buddhism, it also refers to the practice of cultivating generosity."@en .

bud:Deva a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "deva"@sa ;
    skos:definition "Many different types of non-human beings who share characteristics of being more powerful, longer-lived."@en .

bud:DependentOrigination a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dependent origination"@en ;
    skos:definition "See Pratītyasamutpāda — the view that phenomena depend on conditions."@en ;
    rdfs:seeAlso bud:PratityaSamutpada .

bud:Dharma a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dharma"@sa ;
    skos:altLabel "dhamma"@pi ;
    skos:definition "Often refers to the doctrines and teachings of the faith, but it may have broader uses."@en .

bud:DharmaName a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dharma name"@en ;
    skos:altLabel "dhamma name"@en ;
    skos:definition "A new name traditionally bestowed by a Buddhist monastic, given to newly ordained monks, nuns, and laity."@en .

bud:Dhammavinaya a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dhammavinaya"@pi ;
    skos:definition "The dharma and vinaya (roughly 'doctrine and discipline') considered together — the whole teachings of Buddhism."@en .

bud:Dharmacakra a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dharmacakra"@sa ;
    skos:altLabel "dhammacakka"@pi ;
    skos:definition "A symbolic representation of the dharma, also known as the Wheel of Dharma."@en .

bud:Dhammapada a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Dhammapada"@pi ;
    skos:definition "A versified Buddhist scripture traditionally ascribed to the Buddha."@en .

bud:Dharmapala a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dharmapala"@sa ;
    skos:altLabel "dhammapala"@pi ;
    skos:definition "A fearsome deity, known as protector of the Dharma."@en .

bud:Dhyana a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Dhyana"@sa ;
    skos:definition "Meditative contemplation; see jhāna for fuller explanation."@en ;
    rdfs:seeAlso bud:Jhana .

bud:DipankaraBuddha a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Dīpankara Buddha"@sa ;
    skos:definition "A Buddha mentioned in Buddhist texts as a predecessor to Gautama Buddha."@en .

bud:Doan a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "doan"@ja ;
    skos:definition "In Zen, a term for the person sounding the bell marking the beginning and end of zazen."@en .

bud:Dokusan a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dokusan"@ja ;
    skos:definition "A private meeting between Zen student and master demonstrating understanding."@en .

bud:Dudie a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dudie"@zh ;
    skos:definition "Official certificate for monks and nuns issued by government."@en .

bud:Dukkha a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dukkha"@pi ;
    skos:definition "Suffering, dissatisfaction, unsatisfactoriness, stress — the first noble truth."@en .

bud:Dvesa a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dveṣa"@sa ;
    skos:definition "Aversion — one of the three poisons in Buddhist psychology."@en .

bud:Dzogchen a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "dzogchen"@bo ;
    skos:definition "The natural, intrinsic state of every sentient being in Tibetan Buddhist teaching."@en .

#################################################################
# Letter F
#################################################################

bud:FiveFiveHundredYearPeriods a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Five Five-Hundred-Year Periods"@en ;
    skos:definition "Five subdivisions of the three periods following the Buddha's passing, significant for Mahāyāna adherents."@en .

bud:FourNobleTruths a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Four Noble Truths"@en ;
    skos:definition "The central Buddhist teachings covering suffering, its origin, its cessation, and the path to cessation."@en .

bud:Fukudo a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "fukudo"@ja ;
    skos:definition "In Zen, the term for the person who strikes the han (wooden board)."@en .

#################################################################
# Letter G
#################################################################

bud:Gassho a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "gasshō"@ja ;
    skos:definition "A position used for greeting, with the palms together and fingers pointing upwards in prayer position."@en .

bud:GautamaBuddha a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Gautama Buddha"@sa ;
    skos:definition "The historical Buddha, also called Gotama in the Pāli tradition."@en .

bud:Geshe a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "geshe"@bo ;
    skos:definition "A Tibetan Buddhist academic degree in the Gelug tradition, awarded at the conclusion of lengthy studies."@en .

bud:Gongan a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "gongan"@zh ;
    skos:definition "A meditative method generally consisting of a problem that defies solution by means of rational thought."@en .

bud:GuanYin a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Guan Yin"@zh ;
    skos:definition "The bodhisattva of compassion in East Asian Buddhism — female form of Avalokiteśvara."@en .

#################################################################
# Letter H
#################################################################

bud:Han a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "han"@ja ;
    skos:definition "In Zen monasteries, a wooden board struck announcing sunrise, sunset and end of day."@en .

bud:Hinayana a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Hinayana"@sa ;
    skos:definition "Small vehicle — Buddhist doctrines concerned with achievement of Nirvāṇa as an individual."@en .

#################################################################
# Letter I
#################################################################

bud:Ino a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Ino"@ja ;
    skos:definition "Bringer of joy to the assembly — in Zen, supervisor of the meditation hall."@en .

#################################################################
# Letter J
#################################################################

bud:Jetavana a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Jetavana"@sa ;
    skos:definition "A monastery or garden associated with Buddhist sacred sites."@en .

bud:Jhana a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "jhana"@pi ;
    skos:definition "Meditative contemplation; more often associated with śamatha practices than vipaśyanā."@en .

bud:Jisha a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "jisha"@ja ;
    skos:definition "In Zen, a senior priest's attendant."@en .

bud:Jukai a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "jukai"@ja ;
    skos:definition "Zen public ordination ceremony wherein a lay student receives Buddhist precepts."@en .

#################################################################
# Letter K
#################################################################

bud:KakusandhaBuddha a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Kakusandha Buddha"@pi ;
    skos:definition "One of the Buddhas preceding Gautama Buddha in Buddhist cosmology."@en .

bud:Karma a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "karma"@sa ;
    skos:definition "Action — specifically, an action that is driven by intention (cetanā) which leads to future consequences."@en .

bud:Karmasiddhiprakarana a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Karmasiddhiprakaraṇa"@sa ;
    skos:definition "A Buddhist philosophical text on karma and its effects."@en .

bud:KassapaBuddha a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "Kassapa Buddha"@pi ;
    skos:definition "A Buddha mentioned in Buddhist texts as a predecessor to Gautama Buddha."@en .

bud:Kensho a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "kensho"@ja ;
    skos:definition "In Zen, enlightenment; has the same meaning as satori, but is customarily used for an initial awakening experience."@en .

bud:Khyenpo a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "khyenpo"@bo ;
    skos:definition "An academic degree similar to a doctorate in theology, philosophy, and psychology."@en .

bud:Khanti a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "khanti"@pi ;
