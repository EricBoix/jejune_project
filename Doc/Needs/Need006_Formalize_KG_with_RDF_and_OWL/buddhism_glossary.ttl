    skos:definition "A Mahāyāna sūtra describing Amitābha Buddha and the blissful characteristics of the Pure Land."@en .

bud:Sunnata a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "sunnata"@pi ;
