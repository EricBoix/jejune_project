bud:Sura a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "sura"@sa ;
    skos:definition "A divine being or god-like entity in Buddhist cosmology, often depicted enjoying celestial pleasures."@en .

bud:Sutra a owl:Class ;
    rdfs:subClassOf bud:BuddhistConcept ;
    rdfs:label "sutra"@sa ;
