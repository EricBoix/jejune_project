@startuml
title Knowledge Graph Workflow: PDF to Interactive Visualization

skinparam activity {
  BackgroundColor #LightBlue
  BorderColor #Blue
}

start

#Yellow:<<artifact>>\nSource PDF Document|

partition "1. Ingestion preparation (PDF to Markdown)\n<size:10>github/jj_doc_Collecting_Gold_Dust</size>" {
  :Run **data_production.py**
  (uses Convert/main.py);
}

fork
  #Yellow:<<artifact>>\noutput.md|
fork again
  #Yellow:<<artifact>>\nSentences_as_LangChain_Document.json|
end fork

partition "2. GraphRAG ingestion (Markdown to Neo4j)\n<size:10>Doc/ToolTesting/GraphRAG/</size>" {
  :Launch Neo4j via **docker compose**
  Configure **.env** (Neo4j + LLM);
  if (chunking strategy?) then (sentence-based)
    :Run **extracting_graph_semantic_chuncker.py**;
  else (text-splitter)
    :Run **extracting_graph.py**;
  endif
  note right
    ~5800 LLM calls
    for large documents
  end note
}

#Yellow:<<artifact>>\nNeo4j Database (nodes + edges)|

partition "3. Vendor lock workaround (Neo4j to RDF)\n<size:10>Doc/ToolTesting/Neo4jToRDF/</size>" {
  :Run **neo4j_to_rdf.py**;
  note right
    Namespaces:
    ex: = http://example.org/graph/
    neo: = http://example.org/neo4j/
  end note
}

#Yellow:<<artifact>>\noutput.ttl (Turtle RDF)|

partition "4. GraphRAG exploration (Interactive Visualization)\n<size:10>Doc/ToolTesting/vis-network/</size>" {
  :Run **npm run dev** (vis-network);
  :Select nodes/edges
  View metadata
  Edit labels;
}

#Yellow:<<artifact>>\nInteractive Graph UI|

partition "5. Back to original document (Citation Navigation)\n<size:10>Doc/ToolTesting/WebbrowsingMarkdown/</size>" {
  :User clicks graph node;
  :Open URI in **code-server**;
  note right
    URI format:
    #sel=<file>:<sl>:<sc>:<el>:<ec>
  end note
}

#Yellow:<<artifact>>\nHighlighted markdown with range selection|

stop

@enduml
