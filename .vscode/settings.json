{
    "cSpell.customDictionaries": {
        "tim-words": {
            "name": "the_mind_illuminated",
            "path": "${workspaceRoot}/Data/ISBN_978-1-5011-5698-4_-_The_Mind_Illuminated/the_mind_illuminated-words.txt",
            "description": "Words used for TIM",
            "addWords": true
        },
        "the_mind_illuminated": true, // Enable that dictionary
        "gold-dust-words": {
            "name": "collecting_gold_dust",
            "path": "${workspaceRoot}/Data/ISBN_978-0-9835844-5-2_-_Collecting_Gold_Dust/collecting_gold_dust-words.txt",
            "description": "Words used for Collecting Gold Dust:words",
            "addWords": true
        },
        "collecting_gold_dust": true, // Enable that dictionary
        "graphrag-python-sandbox-words": {
            "name": "graph_rag_python_sandbox",
            "path": "${workspaceRoot}/Doc/ToolTesting/GraphRAG/GraphRAG-words.txt",
            "description": "Words used for GraphRAG python sandbox/testing",
            "addWords": true
        },
        "graph_rag_python_sandbox": true, // Enable that dictionary
    },
    "cSpell.words": [
        "neovis",
        "superchapter"
    ],
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter",
      "editor.formatOnSave": true
    },
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "python-envs.workspaceSearchPaths": ["./**/venv"],
    "markdown.extension.toc.levels": "2..5"
}
